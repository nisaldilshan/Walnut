# Builds for Android. The android-ndk package provides the toolchain, so there is no NDK to install. The build also
# packages the example app as an APK with the Android SDK, whose license the last option accepts (see the README):
#   conan export recipes/android-sdk
#   conan build . --build=missing -pr:h testing/conan-profiles/android -pr:b default -o "&:rendering_backend=OpenGL" -c:b user.android-sdk:accept_license=True
# The settings are for a 64-bit ARM device. Add -s arch=x86_64 for an emulator on an x86-64 machine.
include(default)
[settings]
os=Android
# Vulkan needs API level 24 (Android 7.0) or newer
os.api_level=26
arch=armv8
compiler=clang
# The clang version of the NDK below
compiler.version=19
# Walnut and the app are separate shared libraries, which have to share one C++ runtime
compiler.libcxx=c++_shared
compiler.cppstd=17
[options]
# SDL's Java activity loads SDL as libSDL3.so
sdl/*:shared=True
# Android only has OpenGL ES
sdl/*:opengl=False
[conf]
# The sdl recipe asks to confirm that the app takes care of SDL's Java side
user.sdl:android=True
tools.android:cmake_legacy_toolchain=False
[tool_requires]
android-ndk/r28c
